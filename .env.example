NODE_ENV=development

# Postgres
POSTGRES_USER=sentineldock
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=sentineldock
DATABASE_URL=postgres://sentineldock:change_me_local_dev@postgres:5432/sentineldock

# Redis
REDIS_URL=redis://redis:6379

# Backend
BACKEND_PORT=4000

# Worker
WORKER_POLL_INTERVAL_MS=60000
BACKEND_API_URL=http://backend:4000
WORKER_HOSTNAME_OVERRIDE=sentineldock-worker
WORKER_SUBNET_SCAN_ENABLED=true
# Comma-separated CIDRs to sweep in addition to the auto-derived Docker
# bridge subnet — this is how you point discovery at your real LAN/VLANs
# without needing host networking mode. Example:
# WORKER_SCAN_SUBNETS=10.78.0.0/24,10.54.0.0/24,10.33.0.0/24,192.168.1.0/24,192.168.2.0/24
WORKER_SCAN_SUBNETS=
# Confirms Modbus/S7/OPC-UA/BACnet with a real protocol handshake on any
# discovered device with an ICS-associated port open.
WORKER_ICS_SCAN_ENABLED=true
# Scans container environment variables for secrets (AWS keys, private
# keys, generic api_key/password assignments) via docker inspect.
WORKER_SECRETS_SCAN_ENABLED=true
# SNMPv2c sysDescr/sysObjectID GET against the "public" community string.
WORKER_SNMP_SCAN_ENABLED=true
# mDNS (RFC 6762) service enumeration over UDP multicast.
WORKER_MDNS_SCAN_ENABLED=true

# Backend API authentication (opt-in). Leave empty for default local-dev
# mode (no auth enforced). Set to enable a real bearer-token check on all
# mutating (POST/PATCH/PUT/DELETE) endpoints — comma-separated
# "name:token" pairs, e.g. API_TOKENS=worker:changeme,ci:changeme2
API_TOKENS=
# Must be one of the tokens in API_TOKENS (its value, not the name) if
# API_TOKENS is set, so the worker's own writes don't get rejected.
WORKER_API_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_PORT=3000
# API_INTERNAL_URL is set automatically in docker-compose.yml (http://backend:4000)
# for server-side fetches; only override if running the frontend outside Docker.
