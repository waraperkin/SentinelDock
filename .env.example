NODE_ENV=development

# Postgres
POSTGRES_USER=sentineldock
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=sentineldock
DATABASE_URL=postgres://sentineldock:change_me_local_dev@postgres:5432/sentineldock

# Redis
REDIS_URL=redis://redis:6379

# Backend
BACKEND_PORT=4000

# Worker
WORKER_POLL_INTERVAL_MS=60000
BACKEND_API_URL=http://backend:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_PORT=3000
# API_INTERNAL_URL is set automatically in docker-compose.yml (http://backend:4000)
# for server-side fetches; only override if running the frontend outside Docker.
